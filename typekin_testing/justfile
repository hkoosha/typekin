fmt:
  cargo fmt

fix: fmt
  cargo clippy --fix

clippy: fmt
  cargo clippy

build: fmt
  cargo build

test-fast: (z-test 'fast_tests')
test-slow: (z-test 'slow_tests')

z-test features='default': fmt build
  time cargo test --offline --no-default-features --features '{{ features }}'

clean:
  cargo clean

