fmt:
  cargo fmt

fix: fmt
  cargo clippy --fix

clippy: fmt
  cargo clippy --offline --locked --frozen

build: fmt
  cargo build

test-fast: (z-test 'test_fast')
test-slow: (z-test 'test_slow')

z-test features='default': fmt
  time cargo test --offline --no-default-features --features '{{ features }}'

clean:
  cargo clean

