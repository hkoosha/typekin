targets := "wasm32-unknown-unknown aarch64-unknown-linux-gnu armv7-unknown-linux-gnueabihf i686-unknown-linux-gnu"

init:
  for target in {{ targets }}; do \
    rustup +nightly target add "$target"; \
  done
  rustup +nightly component add llvm-tools

fmt:
  cargo fmt

fix: fmt
  cargo clippy --fix

clippy: fmt
  cargo clippy --offline --locked --frozen

build: fmt
  cargo build

test-fast: (z-test 'test_fast')
test-slow: (z-test 'test_slow')

z-test features='default': fmt
  just --justfile ../justfile --working-directory . z-test \
    --no-default-features --features '{{ features }}'

clean:
  cargo clean

